{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ES2022",
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "dist/node",
    "rootDir": "src",
    "sourceMap": true,
    "declaration": false,
    "types": ["node", "electron"]
  },
  "include": ["src/core", "src/main", "src/server", "src/shared"]
}
